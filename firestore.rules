rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sem tela de login de verdade (só Biel + Duda usam) — o app loga anônimo
    // sozinho (invisível) e pede uma senha simples compartilhada na tela,
    // guardada no localStorage do navegador depois da 1a vez. Essa regra só
    // garante que a chamada passou pelo SDK do Firebase (não é público total
    // pra qualquer bot batendo direto na API).
    match /trec-social-radar/{doc} {
      allow read, write: if request.auth != null;
    }

    // Chaves de API (Apify/OpenAI/Anthropic) configuradas pela tela de
    // Configurações: só GRAVA, nunca deixa ler de volta pelo cliente — quem
    // lê de verdade é a function da Vercel via Admin SDK, server-side.
    match /trec-social-radar-config/{doc} {
      allow get, list: if false;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
